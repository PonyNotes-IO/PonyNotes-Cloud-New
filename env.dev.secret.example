# Copy this file to .env.dev.secret and replace the placeholder values with your
# actual secrets. The generate_env.sh script will merge these values into your
# chosen base environment file (deploy.env or dev.env).
#
# Usage:
#   cp env.dev.secret.example .env.dev.secret
#   # Edit .env.dev.secret with your real values
#   ./script/generate_env.sh
#   # Select "dev.env" when prompted

# OAuth Providers (optional)
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=

# AI Features (optional)
AI_OPENAI_API_KEY=

# Managed Agent models (sub2api owns per-user balances and billing)
PONYNOTES_SUB2API_URL=
PONYNOTES_SUB2API_ADMIN_KEY=
# Alternative for sub2api versions whose scoped keys cannot create users.
# Leave ADMIN_KEY empty to use the normal administrator login flow.
PONYNOTES_SUB2API_ADMIN_EMAIL=
PONYNOTES_SUB2API_ADMIN_PASSWORD=
# Random provisioning secret (at least 32 bytes); retain it across restarts.
PONYNOTES_SUB2API_PROVISION_SECRET=
# ID of the standard balance-billed group assigned to each new user's own key.
PONYNOTES_SUB2API_GROUP_ID=
PONYNOTES_CREDITS_PER_USD=100
