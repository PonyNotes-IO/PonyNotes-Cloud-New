FROM ubuntu:26.04
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.cloud.aliyuncs.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.cloud.aliyuncs.com/ubuntu|g; s/^Components:.*/Components: main/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY minio-source/minio /usr/local/bin/minio
ENTRYPOINT ["minio"]
